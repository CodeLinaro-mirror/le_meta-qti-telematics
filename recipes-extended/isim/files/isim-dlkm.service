[Unit]
Description=Load TESIC dlkm service

Requires=isim.mount
After=isim.mount

# Ensure /isim is actually mounted before running
ConditionPathIsMountPoint=/isim

AssertPathExists=/lib/modules/
Conflicts=shutdown.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/etc/initscripts/load_isim.sh start
ExecStop=/etc/initscripts/load_isim.sh stop

[Install]
WantedBy=local-fs.target
