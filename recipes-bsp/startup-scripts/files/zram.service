[Unit]
Description=zram setup service
SourcePath=/sbin/zram-setup

[Service]
Restart=no
RemainAfterExit=yes
ExecStart=/sbin/zram-setup start
ExecStop=/sbin/zram-setup stop
Environment="SWAP_MEMTOTAL_PCT=@SWAP_MEMTOTAL_PCT@"

[Install]
WantedBy=local-fs.target
