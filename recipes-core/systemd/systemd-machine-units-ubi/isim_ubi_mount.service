[Unit]
Description=Attach UBI and mount isim at /isim
SourcePath=/etc/initscripts/isim-ubi-mount.sh
Before=local-fs.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-/etc/initscripts/isim-ubi-mount.sh start
ExecStop=-/etc/initscripts/isim-ubi-mount.sh stop

[Install]
WantedBy=local-fs.target
