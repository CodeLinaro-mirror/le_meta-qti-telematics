[Unit]
Description=Mount persist on /var/persist
Before=sysinit.target

[Mount]
Type=ubifs
What=ubi0:persist
Where=/var/persist
Options=bulk_read,noexec,nodev,nosuid,rootcontext=system_u:object_r:persist_t:s0

[Install]
WantedBy=local-fs.target
