[Unit]
Before=local-fs.target

[Mount]
What=/dev/disk/by-partlabel/isim
Where=/isim
Options=rw,noatime,nodev,noexec,rootcontext=system_u:object_r:isim_fw_t:s0

[Install]
WantedBy=local-fs.target
