[Unit]
Description=Load coresight dlkm
DefaultDependencies=no
Conflicts=shutdown.target

[Service]
Restart=no
RemainAfterExit=yes
Type=oneshot
ExecStart=/etc/initscripts/load_coresight_dlkm
Nice=-20

[Install]
WantedBy=local-fs.target
